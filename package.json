{
  "name": "@markup-carve/astro-carve",
  "version": "0.1.5",
  "type": "module",
  "description": "Astro integration for the Carve markup language - use .crv files as pages and imports, rendered to HTML via carve-js",
  "license": "MIT",
  "author": "Mark Scherer",
  "repository": {
    "type": "git",
    "url": "https://github.com/markup-carve/astro-carve"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "astro-component",
    "carve",
    "markup",
    "withastro"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@markup-carve/carve": "github:markup-carve/carve-js#2003ec4327a736ee29fbb4e6ac108db7c108e50e",
    "@markup-carve/carve-grammars": "github:markup-carve/carve-grammars#5875ac2fa8a7b73d0cd0cfd29206e5a68a96bfb3",
    "js-yaml": "^4.3.2",
    "parse5": "^8.0.1",
    "shiki": "^3.0.0 || ^4.0.0",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "astro": "^7.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "astro": ">=5.9.0 <8.0.0"
  }
}
